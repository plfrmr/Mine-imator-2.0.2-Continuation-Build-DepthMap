	project_render_rt_roughness_cutoff = value_get_real(map[?"rt_roughness_cutoff"], project_render_rt_roughness_cutoff)
	project_render_rt_specular = value_get_real(map[?"rt_specular"], project_render_rt_specular)
	project_render_rt_tinted_shadows = value_get_real(map[?"rt_tinted_shadows"], project_render_rt_tinted_shadows)
