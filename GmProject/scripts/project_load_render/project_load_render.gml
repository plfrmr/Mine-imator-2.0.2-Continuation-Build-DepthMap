	project_render_pbr_pack_maps = value_get_real(map[?"pbr_pack_maps"], project_render_pbr_pack_maps)
	project_render_pbr_roughness = value_get_real(map[?"pbr_roughness"], project_render_pbr_roughness)
	project_render_pbr_metallic = value_get_real(map[?"pbr_metallic"], project_render_pbr_metallic)
